[Unit]
Description=Porchlight BLE home alarm
Documentation=file:///opt/porchlight/README.md
After=bluetooth.service network-online.target
Wants=bluetooth.service

[Service]
Type=simple
User=porchlight
Group=porchlight
SupplementaryGroups=bluetooth
ExecStart=/opt/porchlight/venv/bin/porchlight run --config /etc/porchlight/config.toml
Restart=on-failure
RestartSec=5
# State lives in /var/lib/porchlight (database and the HMAC secret), mode 0700.
StateDirectory=porchlight
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=200M

[Install]
WantedBy=multi-user.target
